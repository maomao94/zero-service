#!/bin/sh
# zero-service pre-push gate: reject any push whose working tree fails to compile.
#
# Owner: local git pre-push hook (this file is the versioned copy).
# Install (once per clone):
#   cp githooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Exact gate command: go build ./...
# (go test for affected packages can be appended here later if needed.)

set -e

cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] running gate: go build ./..."
if ! go build ./...; then
    echo "[pre-push] REJECTED: go build ./... failed, push aborted." >&2
    exit 1
fi
echo "[pre-push] gate passed: build OK"
