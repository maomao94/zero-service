# 本文件由 deploy/tls/gen-tls.sh 生成，请勿手工修改
# 环境: dev
# CN 仅作展示；证书覆盖范围以下面的 subjectAltName 为准
# 新增入口后需重新生成证书并 reload 网关

[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
C = CN
ST = Beijing
L = Beijing
O = Zero Service
OU = Dev
CN = localhost

[v3_req]
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = *.local
DNS.3 = gitlab.localhost
DNS.4 = livekit-server
IP.1 = 127.0.0.1
IP.2 = ::1
