# Copy this file to .env before starting the stack.
# Never use the sample credentials in production.

DOCKER_IMAGE=renater/sipmediagw:1.8.9
MAIN_APP=baresip
CPU_PER_GW=4
GW_NAME=sipmediagw
HOST_IP=127.0.0.1
POSTGRES_HOST=hep_db
ID=1
TZ=UTC
INIT=true

WITH_ALSA=true
DISPLAY=:99
ROOM=test-room
USER=sip-bridge
SIP_PROTOCOL=tcp
SIP_REGISTRAR=127.0.0.1
SIP_PROXY=127.0.0.1
TURN_SRV=127.0.0.1
HEPLIFY_SRV=127.0.0.1

# Optional production integrations.
AUTH_TOKEN=
TOKEN_API_URL=
GW_API_PORT=8100
RTMP_DST=
