syntax = "v1"

info (
	title:   "Live 会议网关"
	desc:    "会议业务 HTTP 网关：业务 API 转发到 app/live gRPC 服务，接收 LiveKit webhook"
	author:  "hehanpeng"
	version: "v1"
)

// ===== 类型定义（与 app/live live.proto 的 JSON 形态一致）=====
type MeetingInfo {
	// 业务会议号（= LiveKit 房间名）
	MeetingNo string `json:"meetingNo"`
	// 用户会议号（9位数字）
	MeetingCode string `json:"meetingCode"`
	// 会议标题
	Title string `json:"title"`
	// 会议状态：1-已创建，2-进行中，3-已结束
	Status int32 `json:"status"`
	// 创建人
	CreateUser string `json:"createUser"`
	// 更新人
	UpdateUser string `json:"updateUser"`
	// 机构 code
	DeptCode string `json:"deptCode"`
	// 开始时间，格式：yyyy-MM-dd HH:mm:ss
	StartTime string `json:"startTime"`
	// 结束时间，格式：yyyy-MM-dd HH:mm:ss（未结束为空字符串）
	EndTime string `json:"endTime"`
	// 创建时间，格式：yyyy-MM-dd HH:mm:ss
	CreateTime string `json:"createTime"`
	// 无人时房间保留秒数（默认 600）
	EmptyTimeout uint32 `json:"emptyTimeout"`
	// 所有人离开后保留秒数（默认 120）
	DepartureTimeout uint32 `json:"departureTimeout"`
	// 最大参会人数（默认 50）
	MaxParticipants uint32 `json:"maxParticipants"`
	// LiveKit 房间 Sid（用于 Egress/Webhook 等场景）
	RoomSid string `json:"roomSid"`
}

type ParticipantInfo {
	// 参与者身份
	Identity string `json:"identity"`
	// 展示名
	Name string `json:"name"`
	// 参会状态：1-已加入，2-已离开
	Status int32 `json:"status"`
	// 加入时间，格式：yyyy-MM-dd HH:mm:ss
	JoinTime string `json:"joinTime"`
	// 离开时间，格式：yyyy-MM-dd HH:mm:ss（未离开为空字符串）
	LeftTime string `json:"leftTime"`
}

type CreateMeetingRequest {
	// 会议标题
	Title string `json:"title"`
}

type CreateMeetingReply {
	Meeting MeetingInfo `json:"meeting"`
}

type JoinMeetingRequest {
	// 会议号（与 meetingCode 二选一）
	MeetingNo string `json:"meetingNo,optional"`
	// 用户会议号（9位数字，与 meetingNo 二选一）
	MeetingCode string `json:"meetingCode,optional"`
	// 是否可以发布音视频
	CanPublish bool `json:"canPublish"`
	// 是否可以订阅音视频
	CanSubscribe bool `json:"canSubscribe"`
	// 是否可以发布数据
	CanPublishData bool `json:"canPublishData"`
	// 可以发布的轨道源类型（空表示允许所有）
	CanPublishSources []string `json:"canPublishSources"`
}

type JoinMeetingReply {
	// join token（浏览器直连 LiveKit 使用）
	Token string `json:"token"`
	// LiveKit WebSocket 地址
	WsUrl string `json:"wsUrl"`
	// 会议信息
	Meeting MeetingInfo `json:"meeting"`
	// 是否可以发布音视频
	CanPublish bool `json:"canPublish"`
	// 是否可以订阅音视频
	CanSubscribe bool `json:"canSubscribe"`
	// 是否可以发布数据
	CanPublishData bool `json:"canPublishData"`
	// 可以发布的轨道源类型（空表示允许所有）
	CanPublishSources []string `json:"canPublishSources"`
}

type NotifyMeetingParticipantRequest {
	// 会议号（与 meetingCode 二选一）
	MeetingNo string `json:"meetingNo,optional"`
	// 用户会议号（9位数字，与 meetingNo 二选一）
	MeetingCode string `json:"meetingCode,optional"`
	// 参会人身份，同时作为 socket 通知房间名
	Identity string `json:"identity"`
}

type NotifyMeetingParticipantReply {
	RequestId string `json:"requestId"`
}

type GetMeetingRequest {
	// 会议号
	MeetingNo string `form:"meetingNo"`
}

type GetMeetingReply {
	Meeting MeetingInfo `json:"meeting"`
}

type ListMeetingsRequest {
	// 过滤状态，0 表示全部
	Status int32 `form:"status,optional"`
	// 页码，从 1 开始
	Page int64 `form:"page,optional"`
	// 每页数量
	PageSize int64 `form:"pageSize,optional"`
	// 创建开始时间，格式：yyyy-MM-dd
	CreateTimeStart string `form:"createTimeStart,optional"`
	// 创建结束时间，格式：yyyy-MM-dd
	CreateTimeEnd string `form:"createTimeEnd,optional"`
	// 机构号
	DeptCode string `form:"deptCode,optional"`
	// 创建人
	CreateUser string `form:"createUser,optional"`
	// 标题模糊查询
	Title string `form:"title,optional"`
	// 参会人身份（按参会人检索，查询与某用户相关的会议）
	Identity string `form:"identity,optional"`
}

type ListMyMeetingsRequest {
	// 过滤状态，0 表示全部
	Status int32 `form:"status,optional"`
	// 页码，从 1 开始
	Page int64 `form:"page,optional"`
	// 每页数量
	PageSize int64 `form:"pageSize,optional"`
}

type ListMeetingsReply {
	Meetings []MeetingInfo `json:"meetings"`
	// 总数量
	Total int64 `json:"total"`
}

type EndMeetingRequest {
	// 会议号
	MeetingNo string `json:"meetingNo"`
}

type KickParticipantRequest {
	// 会议号
	MeetingNo string `json:"meetingNo"`
	// 被踢参与者身份
	Identity string `json:"identity"`
}

type MuteParticipantRequest {
	// 会议号
	MeetingNo string `json:"meetingNo"`
	// 目标参与者身份
	Identity string `json:"identity"`
	// 是否静音（true-静音，false-取消静音）
	Muted bool `json:"muted"`
	// 轨道类型：audio | video
	Kind string `json:"kind"`
}

type ListParticipantsRequest {
	// 会议号
	MeetingNo string `form:"meetingNo"`
}

type ListParticipantsReply {
	Participants []ParticipantInfo `json:"participants"`
}

type SendMeetingDataRequest {
	// 会议号
	MeetingNo string `json:"meetingNo"`
	// 业务约定 topic
	Topic string `json:"topic"`
	// 任意二进制内容（base64）
	Payload string `json:"payload"`
	// 目标身份，空表示广播
	Destinations []string `json:"destinations"`
}

type PerformMeetingRpcRequest {
	// 会议号
	MeetingNo string `json:"meetingNo"`
	// 目标参与者身份
	Identity string `json:"identity"`
	// RPC 方法名
	Method string `json:"method"`
	// 请求负载
	Payload string `json:"payload"`
	// 响应超时时间（毫秒），0 使用服务端默认
	ResponseTimeoutMs uint32 `json:"responseTimeoutMs"`
}

type PerformMeetingRpcReply {
	// RPC 响应内容
	Response string `json:"response"`
}

// ===== 票据相关类型 =====
type GenerateMeetingTicketRequest {
	// 会议号（与 meetingCode 二选一）
	MeetingNo string `json:"meetingNo,optional"`
	// 用户会议号（9位数字，与 meetingNo 二选一）
	MeetingCode string `json:"meetingCode,optional"`
	// 绑定的参会人身份
	Identity string `json:"identity"`
	// 绑定的参会人名称
	Name string `json:"name,optional"`
	// 票据有效期（默认 1）
	ExpireSeconds int32 `json:"expireSeconds,optional"`
	// 是否可以发布音视频（默认 true，总开关）
	CanPublish bool `json:"canPublish,optional"`
	// 是否可以订阅音视频（默认 true，控制访客是否能观看/收听其他人的音视频）
	CanSubscribe bool `json:"canSubscribe,optional"`
	// 是否可以发布数据（默认 true，控制访客是否能发送聊天消息/数据）
	CanPublishData bool `json:"canPublishData,optional"`
	// 可以发布的轨道源类型（默认为空，表示允许所有）
	// 枚举值说明：
	// - camera: 摄像头
	// - microphone: 麦克风
	// - screen_share: 屏幕共享（视频）
	// - screen_share_audio: 屏幕共享音频
	CanPublishSources []string `json:"canPublishSources,optional"`
	// 票据类型：1-一次性（默认，消费后删除），2-有效期（消费后保留至过期，可多次使用）
	TicketType int32 `json:"ticketType,optional"`
}

type GenerateMeetingTicketReply {
	// 票据字符串
	Ticket string `json:"ticket"`
	// 过期时间，格式：yyyy-MM-dd HH:mm:ss
	ExpireTime string `json:"expireTime"`
	// 是否可以发布音视频（回显请求中的权限设置）
	CanPublish bool `json:"canPublish"`
	// 是否可以订阅音视频（回显请求中的权限设置）
	CanSubscribe bool `json:"canSubscribe"`
	// 是否可以发布数据（回显请求中的权限设置）
	CanPublishData bool `json:"canPublishData"`
	// 可以发布的轨道源类型（回显请求中的权限设置）
	// 枚举值说明：
	// - camera: 摄像头
	// - microphone: 麦克风
	// - screen_share: 屏幕共享（视频）
	// - screen_share_audio: 屏幕共享音频
	CanPublishSources []string `json:"canPublishSources"`
	// 票据类型：1-一次性（默认），2-有效期
	TicketType int32 `json:"ticketType"`
}

type JoinMeetingByTicketRequest {
	// 票据字符串（已绑定会议号和参会人）
	Ticket string `form:"ticket"`
}

type JoinMeetingByTicketReply {
	// join token（浏览器直连 LiveKit 使用）
	Token string `json:"token"`
	// 会议信息
	Meeting MeetingInfo `json:"meeting"`
	// 是否可以发布音视频
	CanPublish bool `json:"canPublish"`
	// 是否可以订阅音视频
	CanSubscribe bool `json:"canSubscribe"`
	// 是否可以发布数据
	CanPublishData bool `json:"canPublishData"`
	// 可以发布的轨道源类型（空表示允许所有）
	CanPublishSources []string `json:"canPublishSources"`
}

// ===== 聊天消息相关类型 =====
type GetCurrentUserRequest {}

type GetCurrentUserReply {
	// 用户 ID
	UserId string `json:"userId"`
	// 用户名称
	UserName string `json:"userName"`
	// 部门编码
	DeptCode string `json:"deptCode"`
}

type ReportMeetingMessageRequest {
	// 会议号
	MeetingNo string `json:"meetingNo"`
	// 消息内容
	Content string `json:"content"`
	// 消息类型（text, image, file）
	MessageType string `json:"messageType,optional"`
}

type ReportMeetingMessageReply {
	// 消息 ID（后台生成，用于后续 SDK 推送）
	MessageId string `json:"messageId"`
}

type MeetingMessageInfo {
	// 消息 ID
	MessageId string `json:"messageId"`
	// 发送者 ID
	SenderId string `json:"senderId"`
	// 发送者名称
	SenderName string `json:"senderName"`
	// 消息内容
	Content string `json:"content"`
	// 消息类型
	MessageType string `json:"messageType"`
	// 创建时间，格式：yyyy-MM-dd HH:mm:ss
	CreateTime string `json:"createTime"`
}

type ListMeetingMessagesRequest {
	// 会议号
	MeetingNo string `form:"meetingNo"`
	// 页码，从 1 开始
	Page int64 `form:"page,optional"`
	// 每页数量
	PageSize int64 `form:"pageSize,optional"`
}

type ListMeetingMessagesReply {
	// 消息列表
	Messages []MeetingMessageInfo `json:"messages"`
	// 总数量
	Total int64 `json:"total"`
}

// ===== 票据路由组（不需要鉴权）=====
@server (
	prefix: live/v1
	group:  ticket
)
service livegtw {
	@doc "根据票据加入会议（无需JWT）"
	@handler joinMeetingByTicket
	get /joinMeetingByTicket (JoinMeetingByTicketRequest) returns (JoinMeetingByTicketReply)
}

// ===== 业务路由组（需要鉴权）=====
@server (
	prefix:     live/v1
	group:      live
	jwt:        JwtAuth
	middleware: MeetingAuth
)
service livegtw {
	@doc "创建会议"
	@handler createMeeting
	post /createMeeting (CreateMeetingRequest) returns (CreateMeetingReply)

	@doc "加入会议"
	@handler joinMeeting
	post /joinMeeting (JoinMeetingRequest) returns (JoinMeetingReply)

	@doc "通知用户加入会议"
	@handler notifyMeetingParticipant
	post /notifyMeetingParticipant (NotifyMeetingParticipantRequest) returns (NotifyMeetingParticipantReply)

	@doc "查询会议详情"
	@handler getMeeting
	get /getMeeting (GetMeetingRequest) returns (GetMeetingReply)

	@doc "分页查询会议列表"
	@handler listMeetings
	get /listMeetings (ListMeetingsRequest) returns (ListMeetingsReply)

	@doc "获取当前用户信息"
	@handler getCurrentUser
	get /getCurrentUser (GetCurrentUserRequest) returns (GetCurrentUserReply)

	@doc "查询当前用户的会议列表"
	@handler listMyMeetings
	get /myMeetings (ListMyMeetingsRequest) returns (ListMeetingsReply)

	@doc "结束会议"
	@handler endMeeting
	post /endMeeting (EndMeetingRequest)

	@doc "踢人"
	@handler kickParticipant
	post /kickParticipant (KickParticipantRequest)

	@doc "静音/取消静音"
	@handler muteParticipant
	post /muteParticipant (MuteParticipantRequest)

	@doc "查询会议参与者"
	@handler listParticipants
	get /listParticipants (ListParticipantsRequest) returns (ListParticipantsReply)

	@doc "向会议发送 Data（广播/定向）"
	@handler sendMeetingData
	post /sendMeetingData (SendMeetingDataRequest)

	@doc "服务端对参与者执行 RPC"
	@handler performMeetingRpc
	post /performMeetingRpc (PerformMeetingRpcRequest) returns (PerformMeetingRpcReply)

	@doc "生成会议邀请票据"
	@handler generateMeetingTicket
	post /generateMeetingTicket (GenerateMeetingTicketRequest) returns (GenerateMeetingTicketReply)

	@doc "上报聊天消息"
	@handler reportMeetingMessage
	post /reportMeetingMessage (ReportMeetingMessageRequest) returns (ReportMeetingMessageReply)

	@doc "查询聊天记录"
	@handler listMeetingMessages
	get /listMeetingMessages (ListMeetingMessagesRequest) returns (ListMeetingMessagesReply)
}

// ===== SIP 电话相关类型 =====
type SipProviderInfo {
	Id         string   `json:"id"`
	Code       string   `json:"code"`
	Name       string   `json:"name"`
	Address    string   `json:"address"`
	Numbers    []string `json:"numbers"`
	Status     int32    `json:"status"`
	CreateTime string   `json:"createTime"`
	SipTrunkId string   `json:"sipTrunkId"`
}

type DialSipRequest {
	CalleeNumber    string `json:"calleeNumber"`
	MeetingNo       string `json:"meetingNo,optional"`
	ParticipantName string `json:"participantName,optional"`
	ProviderCode    string `json:"providerCode"`
}

type DialSipReply {
	Meeting   MeetingInfo `json:"meeting"`
	SipCallId string      `json:"sipCallId"`
}

type CreateSipProviderRequest {
	Code         string   `json:"code"`
	Name         string   `json:"name"`
	Address      string   `json:"address"`
	Numbers      []string `json:"numbers"`
	AuthUsername string   `json:"authUsername,optional"`
	AuthPassword string   `json:"authPassword,optional"`
}

type CreateSipProviderReply {
	Provider SipProviderInfo `json:"provider"`
}

type UpdateSipProviderRequest {
	Id           string   `json:"id"`
	Name         string   `json:"name,optional"`
	Address      string   `json:"address,optional"`
	Numbers      []string `json:"numbers,optional"`
	AuthUsername string   `json:"authUsername,optional"`
	AuthPassword string   `json:"authPassword,optional"`
	Status       int32    `json:"status,optional"`
}

type UpdateSipProviderReply {
	Provider SipProviderInfo `json:"provider"`
}

type ListSipProvidersRequest {}

type ListSipProvidersReply {
	Providers []SipProviderInfo `json:"providers"`
}

type DeleteSipProviderRequest {
	Id string `json:"id"`
}

type DeleteSipProviderReply {}

// ===== SIP 路由组（需要鉴权）=====
@server (
	prefix:     live/v1
	group:      live
	jwt:        JwtAuth
	middleware: MeetingAuth
)
service livegtw {
	@doc "发起 SIP 外呼"
	@handler dialSip
	post /sip-calls/dial (DialSipRequest) returns (DialSipReply)
}

@server (
	prefix:     live/v1
	group:      live
	jwt:        JwtAuth
	middleware: MeetingAuth
)
service livegtw {
	@doc "创建 SIP 供应商"
	@handler createSipProvider
	post /sip-providers (CreateSipProviderRequest) returns (CreateSipProviderReply)

	@doc "更新 SIP 供应商"
	@handler updateSipProvider
	post /sip-providers/update (UpdateSipProviderRequest) returns (UpdateSipProviderReply)

	@doc "查询 SIP 供应商列表"
	@handler listSipProviders
	get /sip-providers (ListSipProvidersRequest) returns (ListSipProvidersReply)

	@doc "删除 SIP 供应商"
	@handler deleteSipProvider
	post /sip-providers/delete (DeleteSipProviderRequest) returns (DeleteSipProviderReply)
}

