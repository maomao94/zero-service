# 部署目标（本地测试占位，按实际环境覆盖）
REMOTE_USER=change-me
REMOTE_PASSWD=change-me
REMOTE_PORT=22
REMOTE_HOST=127.0.0.1
REMOTE_PATH=/home/change-me/docker-images
REMOTE_COMPOSE_PATH=/home/change-me/app

# 镜像与服务名（与 docker-compose 中的 service 名一致）
IMAGE_NAME=zxhc.io/allcore-product/opengtw
SERVICE_NAME=allcore-opengtw

# 远程镜像标签（默认 latest）
REMOTE_IMAGE_TAG=1.0.0

# 保留备份数量
BACKUP_KEEP=3
