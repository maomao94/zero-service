app/*/*.tar
facade/*/*.tar
socketapp/*/*.tar

# Kingbase 部署包（镜像 tar 与数据卷不入库）
deploy/kingbase/*.tar
deploy/kingbase/data/
# KDTS 独立部署运行数据
deploy/kdts/data/
deploy/kdts/logs/
deploy/kdts/results/
# dbswitch 独立部署运行数据（H2 配置库）
deploy/dbswitch/data/
# openGauss / PostgreSQL 本地部署持久化（本地开发与测试）
deploy/opengauss/data/
deploy/postgres/data/
# MySQL 本地部署持久化
deploy/mysql/data/
# TDengine 本地部署持久化（数据卷与日志卷）
deploy/tdengine/data/
deploy/tdengine/log/
# Redis 本地部署持久化
deploy/redis/data/
